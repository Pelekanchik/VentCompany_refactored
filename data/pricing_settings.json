  "formula_examples": [
    {
      "name": "Повітропровід прямокутний",
      "formula": "(width + height) * 2 * length / 1000000 * metal_price * 1.15",
      "description": "Периметр × довжину → м² × ціна металу (грн/м²) × коеф. витрат 15%"
    },
    {
      "name": "Повітропровід круглий",
      "formula": "pi * diameter * length / 1000000 * metal_price * 1.15",
      "description": "π × діаметр × довжину → м² × ціна металу × коеф. 1.15"
    },
    {
      "name": "Фланець прямокутний",
      "formula": "(width + 60) * (height + 60) / 1000000 * metal_price * 1.2",
      "description": "Площа з полкою 30 мм × ціна × коеф. 1.2 (отвори під болти)"
    },
    {
      "name": "Фланець круглий",
      "formula": "pi * ((diameter + 60) / 2) ** 2 / 1000000 * metal_price * 1.2",
      "description": "Площа круга з полкою 30 мм × ціна × коеф. 1.2"
    },
    {
      "name": "Трійник прямокутний",
      "formula": "surface_m2 * metal_price * 1.25",
      "description": "Площа поверхні × ціна × коеф. 1.25 (складна геометрія)"
    },
    {
      "name": "Трійник круглий",
      "formula": "pi * diameter * length / 1000000 * metal_price * 1.25",
      "description": "π × діаметр × довжину → м² × ціна × коеф. 1.25"
    },
    {
      "name": "Перехід прямокутний",
      "formula": "surface_m2 * metal_price * 1.2",
      "description": "Площа поверхні × ціна × коеф. 1.2"
    },
    {
      "name": "Перехід круглий",
      "formula": "pi * ((diameter + end_diameter) / 2) * length / 1000000 * metal_price * 1.2",
      "description": "Середній діаметр × довжину → м² × ціна × коеф. 1.2"
    },
    {
      "name": "Відвід прямокутний",
      "formula": "perimeter_mm * length / 1000000 * metal_price * 1.25",
      "description": "Периметр × довжину дуги × ціна × коеф. 1.25 (гнуття)"
    },
    {
      "name": "Відвід круглий",
      "formula": "pi * diameter * length / 1000000 * metal_price * 1.25",
      "description": "π × діаметр × довжину дуги → м² × ціна × коеф. 1.25"
    },
    {
      "name": "Заглушка прямокутна",
      "formula": "(width * height + 2 * (width + height) * 25) / 1000000 * metal_price * 1.1",
      "description": "Дно + боки (глибина 25 мм) × ціна × коеф. 1.1"
    },
    {
      "name": "Заглушка кругла",
      "formula": "(pi * (diameter / 2) ** 2 + pi * diameter * 30) / 1000000 * metal_price * 1.1",
      "description": "Дно + бік (глибина 30 мм) × ціна × коеф. 1.1"
    },
    {
      "name": "Проста площа × ціна",
      "formula": "surface_m2 * metal_price",
      "description": "Базова формула: площа поверхні (м²) × ціна металу (грн/м²)"
    },
    {
      "name": "Площа × ціна × коеф. витрат",
      "formula": "surface_m2 * metal_price * 1.15",
      "description": "Площа × ціна × 1.15 (15% на відходи при розкрої)"
    },
    {
      "name": "Вага × ціна за кг (стара система)",
      "formula": "weight_kg * (metal_price / (thickness / 1000 * 7850))",
      "description": "УВАГА: тут metal_price має бути ціною за КГ, не за м²! Використовуйте surface_m2 * metal_price замість цього."
    }
  ],

