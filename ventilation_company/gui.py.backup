#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
ГРАФІЧНИЙ ІНТЕРФЕЙС ВЕНТИЛЯЦІЙНОЇ ФІРМИ
Роздільна здатність: 1920x1080
"""

import tkinter as tk
from tkinter import ttk, messagebox, filedialog, colorchooser
from ventilation_company.drawing_editor import launch_editor
import sys
import os

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from ventilation_company.database import init_database, execute_query
from ventilation_company.project_builder.project import Project
from ventilation_company.project_builder.components import ComponentCatalog, DuctCalculator
from ventilation_company.project_builder.specifications import SpecificationBuilder
from ventilation_company.project_builder.export import ProjectExporter
from ventilation_company.calculations.cost_calculator import CostCalculator
from ventilation_company.calculations.salary_calculator import SalaryCalculator
from ventilation_company.calculations.expenses import ExpenseTracker, ProductionCostAnalyzer
from ventilation_company.calculations.pricing import PricingEngine
from ventilation_company.archive.storage import ArchiveStorage
from ventilation_company.archive.analytics import ProductionAnalytics
from ventilation_company.archive.statistics import ProductionStatistics
from ventilation_company.archive.reports import ReportGenerator
from ventilation_company.config import VENTILATION_TYPES, MATERIALS, COMPONENTS, WORKS, POSITIONS, DB_PATH
from ventilation_company.ventilation_company.ventilation_company.detail_calculator import DetailCalculatorFrame
from ventilation_company.camduct_editor import CamDuctEditorFrame
from ventilation_company.cad_editor import CADEditorFrame
from price_list_tab import PriceListTab


class VentilationApp:
    def __init__(self, root):
        self.root = root
        self.root.title("ВЕНТИЛЯЦІЙНА ВИРОБНИЧА ФІРМА — Система управління")
        self.root.geometry("1920x1080")
        self.root.state("zoomed")
        self.root.minsize(1400, 900)

        self.themes = {
            "Світла": {"bg": "#f0f0f0", "fg": "#333333", "sidebar": "#2c3e50", 
                       "sidebar_fg": "white", "accent": "#3498db", "card": "white"},
            "Темна": {"bg": "#1a1a2e", "fg": "#eaeaea", "sidebar": "#16213e",
                      "sidebar_fg": "#eaeaea", "accent": "#e94560", "card": "#0f3460"},
            "Зелена": {"bg": "#e8f5e9", "fg": "#1b5e20", "sidebar": "#2e7d32",
                       "sidebar_fg": "white", "accent": "#66bb6a", "card": "#c8e6c9"},
            "Синя": {"bg": "#e3f2fd", "fg": "#0d47a1", "sidebar": "#1565c0",
                      "sidebar_fg": "white", "accent": "#42a5f5", "card": "#bbdefb"},
            "Помаранчева": {"bg": "#fff3e0", "fg": "#e65100", "sidebar": "#ef6c00",
                             "sidebar_fg": "white", "accent": "#ff9800", "card": "#ffe0b2"},
        }
        self.current_theme = "Світла"
        self.colors = self.themes[self.current_theme]

        init_database()
        self.create_menu()
        self.create_sidebar()
        self.create_content_area()
        self.show_projects_tab()

    def _parse_float(self, value_str, field_name, allow_empty=True):
        """Безпечне перетворення рядка у float з українською комою/крапкою."""
        raw = (value_str or "").strip().replace(',', '.')
        if allow_empty and not raw:
            return 0.0
        try:
            return float(raw)
        except ValueError:
            raise ValueError(f"Невірне значення у полі '{field_name}': '{value_str}'. Введіть число.")

    def show_price_list_tab(self):
        frame = self.tabs["price_list"]
        for widget in frame.winfo_children():
            widget.destroy()
        PriceListTab(frame, self.root, colors=self.colors)
        self.show_tab("price_list", "ПРАЙС-ЛИСТ ВИРОБІВ")

    def open_project_drawing(self):
        pid = self.get_selected_project_id()
        if pid is None:
            return
        project = Project.load_from_db(pid)
        if not project:
            messagebox.showerror("Помилка", "Проект не знайдено!")
            return
        try:
            launch_editor(DB_PATH, pid, project.name)
        except ImportError as e:
            messagebox.showerror("Помилка", str(e))
        except Exception as e:
            messagebox.showerror("Помилка", f"Не вдалося відкрити редактор: {e}")

    def apply_theme(self):
        c = self.colors
        self.root.configure(bg=c["bg"])
        self.sidebar_frame.configure(bg=c["sidebar"])
        self.content_frame.configure(bg=c["bg"])
        for btn in self.sidebar_buttons:
            btn.configure(bg=c["sidebar"], fg=c["sidebar_fg"], 
                         activebackground=c["accent"], activeforeground="white")
        self.header_label.configure(bg=c["bg"], fg=c["fg"])
        for frame in self.tabs.values():
            frame.configure(bg=c["bg"])
            for child in frame.winfo_children():
                if isinstance(child, tk.Frame):
                    child.configure(bg=c["bg"])
                elif isinstance(child, tk.Label):
                    child.configure(bg=c["bg"], fg=c["fg"])
                elif isinstance(child, ttk.Frame):
                    for subchild in child.winfo_children():
                        if isinstance(subchild, tk.Label):
                            subchild.configure(bg=c["bg"], fg=c["fg"])

    def create_menu(self):
        menubar = tk.Menu(self.root)
        self.root.config(menu=menubar)

        theme_menu = tk.Menu(menubar, tearoff=0)
        for theme_name in self.themes.keys():
            theme_menu.add_command(label=theme_name, 
                                   command=lambda t=theme_name: self.change_theme(t))
        menubar.add_cascade(label="Тема", menu=theme_menu)

        action_menu = tk.Menu(menubar, tearoff=0)
        action_menu.add_command(label="Повний звіт", command=self.generate_full_report)
        action_menu.add_command(label="Аналітична панель", command=self.show_analytics)
        action_menu.add_separator()
        action_menu.add_command(label="Вихід", command=self.root.quit)
        menubar.add_cascade(label="Дії", menu=action_menu)

        help_menu = tk.Menu(menubar, tearoff=0)
        help_menu.add_command(label="Про програму", command=self.show_about)
        menubar.add_cascade(label="Довідка", menu=help_menu)

    def change_theme(self, theme_name):
        self.current_theme = theme_name
        self.colors = self.themes[theme_name]
        self.apply_theme()
        messagebox.showinfo("Тему змінено", f"Встановлено тему: {theme_name}")

    def create_sidebar(self):
        c = self.colors
        self.sidebar_frame = tk.Frame(self.root, bg=c["sidebar"], width=250)
        self.sidebar_frame.pack(side=tk.LEFT, fill=tk.Y)
        self.sidebar_frame.pack_propagate(False)

        logo_label = tk.Label(self.sidebar_frame, text="ВЕНТ-ФІРМА", 
                              bg=c["sidebar"], fg=c["sidebar_fg"],
                              font=("Arial", 20, "bold"), pady=20)
        logo_label.pack(fill=tk.X)

        tk.Frame(self.sidebar_frame, bg=c["accent"], height=2).pack(fill=tk.X, padx=10)

        self.sidebar_buttons = []
        tabs_config = [
            ("Проекти", self.show_projects_tab),
            ("Вироби", self.show_components_tab),
            ("Роботи", self.show_works_tab),
            ("Бухгалтерія", self.show_accounting_tab),
            ("Архів", self.show_archive_tab),
            ("Аналітика", self.show_analytics_tab),
            ("Розкрій листа", self.show_camduct_tab),
            ("Креслення", self.show_cad_tab),
            ("Прайс-лист", self.show_price_list_tab),
        ]

        for text, command in tabs_config:
            btn = tk.Button(self.sidebar_frame, text=text, bg=c["sidebar"], 
                           fg=c["sidebar_fg"], font=("Arial", 12),
                           activebackground=c["accent"], activeforeground="white",
                           bd=0, pady=12, cursor="hand2",
                           command=command)
            btn.pack(fill=tk.X, padx=10, pady=2)
            self.sidebar_buttons.append(btn)

        tk.Frame(self.sidebar_frame, bg=c["accent"], height=2).pack(fill=tk.X, padx=10, pady=10)

        self.status_label = tk.Label(self.sidebar_frame, text="Система активна", 
                                     bg=c["sidebar"], fg=c["sidebar_fg"],
                                     font=("Arial", 9), pady=10)
        self.status_label.pack(side=tk.BOTTOM, fill=tk.X)

    def create_content_area(self):
        c = self.colors
        self.content_frame = tk.Frame(self.root, bg=c["bg"])
        self.content_frame.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)

        self.header_label = tk.Label(self.content_frame, 
                                     text="УПРАВЛІННЯ ПРОЕКТАМИ ВЕНТИЛЯЦІЇ",
                                     bg=c["bg"], fg=c["fg"],
                                     font=("Arial", 24, "bold"), pady=20)
        self.header_label.pack(fill=tk.X)

        self.tabs_container = tk.Frame(self.content_frame, bg=c["bg"])
        self.tabs_container.pack(fill=tk.BOTH, expand=True, padx=20, pady=10)

        self.tabs = {}
        self.create_all_tabs()

    def create_all_tabs(self):
        for tab_name in ["projects", "new_project", "components", "works", "accounting",
                         "calculations", "salary", "expenses", "archive", "analytics", "reports", "camduct", "cad" , "price_list"]:
            frame = tk.Frame(self.tabs_container, bg=self.colors["bg"])
            frame.place(relwidth=1, relheight=1)
            frame.lower()
            self.tabs[tab_name] = frame

    def show_tab(self, tab_name, title):
        self.header_label.config(text=title)
        for name, frame in self.tabs.items():
            if name == tab_name:
                frame.lift()
            else:
                frame.lower()
        self.status_label.config(text=f"Активна вкладка: {title}")

    # ==================== ВКЛАДКА: ПРОЕКТИ ====================
    def show_projects_tab(self):
        frame = self.tabs["projects"]
        for widget in frame.winfo_children():
            widget.destroy()

        c = self.colors

        btn_frame = tk.Frame(frame, bg=c["bg"])
        btn_frame.pack(fill=tk.X, pady=10)

        tk.Button(btn_frame, text="➕ Новий проект", bg="#27ae60", fg="white",
                  font=("Arial", 11), command=self.show_new_project_dialog).pack(side=tk.LEFT, padx=5)
        tk.Button(btn_frame, text="Оновити", bg=c["accent"], fg="white",
                  font=("Arial", 11), command=self.show_projects_tab).pack(side=tk.LEFT, padx=5)
        tk.Button(btn_frame, text="Редагувати", bg=c["accent"], fg="white",
                  font=("Arial", 11), command=self.edit_selected_project).pack(side=tk.LEFT, padx=5)
        tk.Button(btn_frame, text="Видалити", bg="#e74c3c", fg="white",
                  font=("Arial", 11), command=self.delete_selected_project).pack(side=tk.LEFT, padx=5)
        tk.Button(btn_frame, text="Розрахунок", bg="#27ae60", fg="white",
                  font=("Arial", 11), command=self.calculate_selected_project).pack(side=tk.LEFT, padx=5)
        tk.Button(btn_frame, text="Експорт", bg="#9b59b6", fg="white",
                  font=("Arial", 11), command=self.export_selected_project).pack(side=tk.LEFT, padx=5)
        tk.Button(btn_frame, text="📐 Креслення", bg="#1abc9c", fg="white",
                  font=("Arial", 11), command=self.open_project_drawing).pack(side=tk.LEFT, padx=5)
        
        columns = ("ID", "Номер", "Назва", "Замовник", "Тип", "Статус", "Дата")
        self.projects_tree = ttk.Treeview(frame, columns=columns, show="headings", height=25)

        for col in columns:
            self.projects_tree.heading(col, text=col)
            self.projects_tree.column(col, width=150)
        self.projects_tree.column("ID", width=50)
        self.projects_tree.column("Номер", width=120)

        scrollbar = ttk.Scrollbar(frame, orient=tk.VERTICAL, command=self.projects_tree.yview)
        self.projects_tree.configure(yscrollcommand=scrollbar.set)

        self.projects_tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

        self.load_projects_data()

        self.show_tab("projects", "ПРОЕКТИ")

    def load_projects_data(self):
        for item in self.projects_tree.get_children():
            self.projects_tree.delete(item)
        projects = Project.list_all_projects()
        for proj in projects:
            self.projects_tree.insert("", tk.END, values=proj)

    def get_selected_project_id(self):
        selected = self.projects_tree.selection()
        if not selected:
            messagebox.showwarning("Увага", "Оберіть проект!")
            return None
        item = self.projects_tree.item(selected[0])
        return item["values"][0]

    def edit_selected_project(self):
        pid = self.get_selected_project_id()
        if pid:
            self.show_edit_project_dialog(pid)

    def delete_selected_project(self):
        pid = self.get_selected_project_id()
        if pid:
            if messagebox.askyesno("Підтвердження", "Видалити проект?"):
                execute_query("DELETE FROM projects WHERE id = ?", (pid,))
                self.load_projects_data()
                messagebox.showinfo("Успіх", "Проект видалено")

    def calculate_selected_project(self):
        pid = self.get_selected_project_id()
        if pid:
            project = Project.load_from_db(pid)
            if project:
                calc = CostCalculator(project)
                result = calc.calculate()
                calc.save_calculation()

                msg = f"""РОЗРАХУНОК ВАРТОСТІ:
Матеріали: {result['materials_cost']:.2f} грн
Комплектуючі: {result['components_cost']:.2f} грн
Роботи: {result['works_cost']:.2f} грн
Собівартість: {result['total_cost']:.2f} грн
Націнка ({result['markup_percentage']}%): {result['markup_amount']:.2f} грн
ПДВ ({result['vat_rate']}%): {result['vat_amount']:.2f} грн
КІНЦЕВА ЦІНА: {result['final_price']:.2f} грн
Прибуток: {result['profit']:.2f} грн
Рентабельність: {result['profit_margin_percent']:.2f}%"""
                messagebox.showinfo("Розрахунок", msg)

    def export_selected_project(self):
        pid = self.get_selected_project_id()
        if pid:
            project = Project.load_from_db(pid)
            if project:
                exporter = ProjectExporter(project)
                files = exporter.export_all()
                messagebox.showinfo("Експорт", f"Проект експортовано!\nФайлів: {len(files)}")

    def show_edit_project_dialog(self, pid):
        project = Project.load_from_db(pid)
        if not project:
            return

        dialog = tk.Toplevel(self.root)
        dialog.title(f"Редагування проекту {project.project_number}")
        dialog.geometry("980x520")
        dialog.configure(bg=self.colors["bg"])
        dialog.minsize(650, 450)

        c = self.colors

        # --- Canvas з прокруткою ---
        canvas = tk.Canvas(dialog, bg=c["bg"], highlightthickness=0)
        vsb = ttk.Scrollbar(dialog, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=vsb.set)
        vsb.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)

        content = tk.Frame(canvas, bg=c["bg"])
        canvas_window = canvas.create_window((0, 0), window=content, anchor="nw")

        def on_configure(event=None):
            canvas.configure(scrollregion=canvas.bbox("all"))
            canvas.itemconfig(canvas_window, width=canvas.winfo_width())

        content.bind("<Configure>", on_configure)
        canvas.bind("<Configure>", lambda e: canvas.itemconfig(canvas_window, width=e.width))

        notebook = ttk.Notebook(content)
        notebook.pack(fill="both", expand=True, padx=5, pady=5)

        # ═══════════════════════════════════════════════
        #  ВКЛАДКА: ОСНОВНЕ
        # ═══════════════════════════════════════════════
        tab_main = tk.Frame(notebook, bg=c["bg"])
        notebook.add(tab_main, text=" Основне ")

        def make_field(parent, label_text, default, width=40):
            row = tk.Frame(parent, bg=c["bg"])
            row.pack(fill="x", pady=2, padx=5)
            tk.Label(row, text=label_text, bg=c["bg"], fg=c["fg"], font=("Arial", 10), width=20, anchor="e").pack(side="left")
            e = tk.Entry(row, font=("Arial", 10), width=width)
            e.insert(0, default)
            e.pack(side="left", padx=5, fill="x", expand=True)
            return e

        name_entry = make_field(tab_main, "Назва:", project.name)
        client_entry = make_field(tab_main, "Замовник:", project.client)
        address_entry = make_field(tab_main, "Адреса:", project.address)

        row = tk.Frame(tab_main, bg=c["bg"])
        row.pack(fill="x", pady=2, padx=5)
        tk.Label(row, text="Тип вентиляції:", bg=c["bg"], fg=c["fg"], font=("Arial", 10), width=20, anchor="e").pack(side="left")
        type_var = tk.StringVar(value=project.ventilation_type)
        ttk.Combobox(row, textvariable=type_var, values=VENTILATION_TYPES, font=("Arial", 10), width=38, state="readonly").pack(side="left", padx=5, fill="x", expand=True)

        row = tk.Frame(tab_main, bg=c["bg"])
        row.pack(fill="x", pady=2, padx=5)
        tk.Label(row, text="Витрата (м³/год):", bg=c["bg"], fg=c["fg"], font=("Arial", 10), width=20, anchor="e").pack(side="left")
        airflow_entry = tk.Entry(row, font=("Arial", 10), width=12)
        airflow_entry.insert(0, str(project.air_flow))
        airflow_entry.pack(side="left", padx=5)
        tk.Label(row, text="Тиск (Па):", bg=c["bg"], fg=c["fg"], font=("Arial", 10), width=12, anchor="e").pack(side="left")
        pressure_entry = tk.Entry(row, font=("Arial", 10), width=12)
        pressure_entry.insert(0, str(project.pressure))
        pressure_entry.pack(side="left", padx=5)

        row = tk.Frame(tab_main, bg=c["bg"])
        row.pack(fill="x", pady=2, padx=5)
        tk.Label(row, text="Статус:", bg=c["bg"], fg=c["fg"], font=("Arial", 10), width=20, anchor="e").pack(side="left")
        status_var = tk.StringVar(value=project.status)
        ttk.Combobox(row, textvariable=status_var, values=["draft", "active", "completed", "archived"], font=("Arial", 10), width=38, state="readonly").pack(side="left", padx=5, fill="x", expand=True)

        def save_changes():
            try:
                new_air_flow = self._parse_float(airflow_entry.get(), "Витрата повітря")
                new_pressure = self._parse_float(pressure_entry.get(), "Тиск")
            except ValueError as e:
                messagebox.showerror("Помилка вводу", str(e))
                return

            project.name = name_entry.get()
            project.client = client_entry.get()
            project.address = address_entry.get()
            project.ventilation_type = type_var.get()
            project.air_flow = new_air_flow
            project.pressure = new_pressure
            project.status = status_var.get()
            project.update_in_db()
            self.load_projects_data()
            dialog.destroy()
            messagebox.showinfo("Успіх", "Проект оновлено!")

        tk.Button(tab_main, text="💾 ЗБЕРЕГТИ", bg="#27ae60", fg="white",
                  font=("Arial", 11, "bold"), command=save_changes).pack(pady=15)

        # ═══════════════════════════════════════════════
        #  ВКЛАДКА: ВИТРАТИ
        # ═══════════════════════════════════════════════
        tab_items = tk.Frame(notebook, bg=c["bg"])
        notebook.add(tab_items, text=" Витрати ")

        cols = tk.Frame(tab_items, bg=c["bg"])
        cols.pack(fill="both", expand=True, padx=3, pady=3)

        def make_col(parent, title, items_list):
            col = tk.LabelFrame(parent, text=title, bg=c["bg"], fg=c["fg"], font=("Arial", 9, "bold"))
            col.pack(side="left", fill="both", expand=True, padx=2)
            txt = tk.Text(col, height=10, width=20, font=("Consolas", 9), bg=c["card"], fg=c["fg"], wrap="word")
            txt.pack(fill="both", expand=True, padx=2, pady=2)
            for item in items_list:
                unit = item.get("unit", "")
                txt.insert("end", f"• {item['name']}: {item['quantity']:.2f} {unit} = {item['total_price']:.2f} грн\n")
            txt.config(state="disabled")
            return txt

        make_col(cols, "Комплектуючі", project._components)
        make_col(cols, "Матеріали", project._materials)
        make_col(cols, "Роботи", project._works)

        # ═══════════════════════════════════════════════
        #  ВКЛАДКА: КРЕСЛЕННЯ
        # ═══════════════════════════════════════════════
        tab_draw = tk.Frame(notebook, bg=c["bg"])
        notebook.add(tab_draw, text=" Креслення ")

        draw_frame = tk.Frame(tab_draw, bg=c["bg"])
        draw_frame.pack(fill="x", padx=10, pady=15)

        has_drawing = execute_query(
            "SELECT COUNT(*) FROM project_drawings WHERE project_id = ?",
            (pid,), fetch_one=True
        )[0] > 0

        status_text = "✅ Креслення збережено в БД" if has_drawing else "❌ Креслення відсутнє"
        status_color = "#27ae60" if has_drawing else "#e74c3c"
        tk.Label(draw_frame, text=status_text, bg=c["bg"], fg=status_color, font=("Arial", 11)).pack(anchor="w")

        tk.Button(draw_frame, text="📐 Відкрити редактор", bg="#1abc9c", fg="white",
                  font=("Arial", 10), command=lambda p=pid, n=project.name: launch_editor(DB_PATH, p, n)
                  ).pack(anchor="w", pady=10)

        # ═══════════════════════════════════════════════
        #  ВКЛАДКА: КП
        # ═══════════════════════════════════════════════
        tab_kp = tk.Frame(notebook, bg=c["bg"])
        notebook.add(tab_kp, text=" КП ")

        kp_frame = tk.Frame(tab_kp, bg=c["bg"])
        kp_frame.pack(fill="both", expand=True, padx=5, pady=5)

        from ventilation_company.database import get_calc_db
        db = get_calc_db()
        calcs = db.execute(
            "SELECT id, client_name, created_at, total_cost, sale_price FROM calc_calculations WHERE project_id = ? ORDER BY created_at DESC",
            (pid,)
        ).fetchall()
        db.close()

        if calcs:
            columns = ("№", "Дата", "Собівартість", "Ціна", "Прибуток")
            kp_tree = ttk.Treeview(kp_frame, columns=columns, show="headings", height=8)
            for col in columns:
                kp_tree.heading(col, text=col)
            kp_tree.column("№", width=50, anchor="center")
            kp_tree.column("Дата", width=90, anchor="center")
            kp_tree.column("Собівартість", width=100, anchor="e")
            kp_tree.column("Ціна", width=100, anchor="e")
            kp_tree.column("Прибуток", width=100, anchor="e")
            kp_tree.pack(fill="both", expand=True)

            for kp in calcs:
                profit = kp["sale_price"] - kp["total_cost"]
                color_tag = "profit" if profit >= 0 else "loss"
                kp_tree.insert("", "end", values=(
                    kp["id"], kp["created_at"][:10],
                    f"{kp['total_cost']:.2f}", f"{kp['sale_price']:.2f}", f"{profit:.2f}"
                ), tags=(color_tag,))
            kp_tree.tag_configure("profit", foreground="#16a34a")
            kp_tree.tag_configure("loss", foreground="#dc2626")
        else:
            tk.Label(kp_frame, text="Немає розрахунків", bg=c["bg"], fg="#888", font=("Arial", 10, "italic")).pack(pady=20)

    # ==================== ВКЛАДКА: НОВИЙ ПРОЕКТ ====================    # ==================== ВКЛАДКА: НОВИЙ ПРОЕКТ ====================
    def show_new_project_tab(self):
        """Залишено для сумісності — тепер відкриває діалог"""
        self.show_new_project_dialog()

    def show_new_project_dialog(self):
        """Відкриває діалог створення нового проекту (Toplevel)"""
        c = self.colors
        dialog = tk.Toplevel(self.root)
        dialog.title("Створення нового проекту")
        dialog.geometry("700x500")
        dialog.configure(bg=c["bg"])
        dialog.transient(self.root)
        dialog.grab_set()
        dialog.focus_set()

        tk.Label(dialog, text="СТВОРЕННЯ НОВОГО ПРОЕКТУ", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 18, "bold")).pack(pady=15)

        fields = [
            ("Назва проекту*:", "name", ""),
            ("Замовник:", "client", ""),
            ("Адреса об'єкту:", "address", ""),
            ("Витрата повітря (м³/год):", "airflow", "0"),
            ("Тиск (Па):", "pressure", "0"),
        ]

        entries = {}

        for label_text, key, default in fields:
            row = tk.Frame(dialog, bg=c["bg"])
            row.pack(fill=tk.X, pady=6, padx=30)

            tk.Label(row, text=label_text, bg=c["bg"], fg=c["fg"],
                     font=("Arial", 11), width=25, anchor=tk.E).pack(side=tk.LEFT)

            entry = tk.Entry(row, font=("Arial", 11), width=45)
            entry.insert(0, default)
            entry.pack(side=tk.LEFT, padx=10)
            entries[key] = entry

        row = tk.Frame(dialog, bg=c["bg"])
        row.pack(fill=tk.X, pady=6, padx=30)
        tk.Label(row, text="Тип вентиляції:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 11), width=25, anchor=tk.E).pack(side=tk.LEFT)
        vent_type_var = tk.StringVar(value="припливна")
        ttk.Combobox(row, textvariable=vent_type_var, values=VENTILATION_TYPES,
                     font=("Arial", 11), width=42).pack(side=tk.LEFT, padx=10)

        def create_project():
            name = entries["name"].get().strip()
            if not name:
                messagebox.showerror("Помилка", "Введіть назву проекту!")
                return

            try:
                air_flow = self._parse_float(entries["airflow"].get(), "Витрата повітря")
                pressure = self._parse_float(entries["pressure"].get(), "Тиск")
            except ValueError as e:
                messagebox.showerror("Помилка вводу", str(e))
                return

            project = Project(
                name=name,
                client=entries["client"].get(),
                address=entries["address"].get(),
                ventilation_type=vent_type_var.get(),
                air_flow=air_flow,
                pressure=pressure
            )

            if project.validate()[0]:
                project.save_to_db()
                messagebox.showinfo("Успіх", "Проект створено!\nНомер: " + str(project.project_number))
                dialog.destroy()
                self.show_projects_tab()
            else:
                messagebox.showerror("Помилка", "Помилки валідації")

        tk.Button(dialog, text="СТВОРИТИ ПРОЕКТ", bg="#27ae60", fg="white",
                  font=("Arial", 14, "bold"), command=create_project).pack(pady=20)

        tk.Button(dialog, text="Скасувати", bg="#95a5a6", fg="white",
                  font=("Arial", 11), command=dialog.destroy).pack()

    # ==================== ВКЛАДКА: НОВИЙ ПРОЕКТ (залишено для сумісності) ====================

    # ==================== СИНХРОНІЗАЦІЯ З РОЗКРОЄМ ====================
    def ensure_camduct_initialized(self):
        """Переконується, що CamDuctEditor створений, без перемикання вкладки"""
        if not hasattr(self, 'camduct_editor') or self.camduct_editor is None:
            frame = self.tabs["camduct"]
            for widget in frame.winfo_children():
                widget.destroy()
            c = self.colors
            tk.Label(frame, text="РОЗКРІЙ ЛИСТОВОГО МЕТАЛУ (CamDuct)", bg=c["bg"], fg=c["fg"],
                     font=("Arial", 20, "bold")).pack(fill=tk.X, pady=10)
            editor_frame = tk.Frame(frame, bg=c["bg"])
            editor_frame.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)
            self.camduct_editor = CamDuctEditorFrame(editor_frame, colors=self.colors)
            self.camduct_editor.pack(fill=tk.BOTH, expand=True)

    def sync_to_camduct(self):
        """Передає деталі з калькулятора виробів у розкрій листа"""
        if not hasattr(self, 'detail_calculator') or not self.detail_calculator.calc_items:
            messagebox.showwarning("Увага", "Спочатку додайте вироби у вкладці 'Вироби'!")
            return
        self.ensure_camduct_initialized()
        count = self.camduct_editor.import_calc_items(self.detail_calculator.calc_items, clear_existing=True)
        if count > 0:
            messagebox.showinfo("Готово", f"Передано {count} позицій на розкрій!\n\n"
                               "Перейдіть на вкладку 'Розкрій листа' та натисніть 'РОЗКРИТИ'.")
        else:
            messagebox.showwarning("Увага", "Не вдалося передати деталі. Перевірте типи виробів.")

    # ==================== ВКЛАДКА: ВИРОБИ (Детальний калькулятор) ====================
    def show_components_tab(self):
        frame = self.tabs["components"]
        for widget in frame.winfo_children():
            widget.destroy()

        c = self.colors
        # === ВИБІР ПРОЕКТУ ===
        proj_bar = tk.Frame(frame, bg=c["bg"])
        proj_bar.pack(fill=tk.X, padx=10, pady=(0, 10))

        tk.Label(proj_bar, text="📁 Проект:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 12, "bold")).pack(side=tk.LEFT)

        projects = Project.list_all_projects()
        self._comp_project_list = projects
        proj_values = [f"{p[0]}: {p[2]}" for p in projects]

        self.comp_project_var = tk.StringVar()
        self.comp_project_combo = ttk.Combobox(proj_bar, values=proj_values,
                                                width=45, state="readonly", font=("Arial", 11))
        self.comp_project_combo.pack(side=tk.LEFT, padx=10)
        if proj_values:
            self.comp_project_combo.current(0)

        # Кнопка синхронізації з розкроєм
        tk.Button(proj_bar, text="📤 Передати на розкрій", bg="#e67e22", fg="white",
                  font=("Arial", 10, "bold"), cursor="hand2",
                  command=self.sync_to_camduct).pack(side=tk.LEFT, padx=(20, 5))

        # Кнопки калькулятора
        tk.Button(proj_bar, text="🧮 Розрахувати", bg="#27ae60", fg="white",
                  font=("Arial", 10, "bold"), cursor="hand2",
                  command=lambda: self.detail_calculator.calculate_all() if hasattr(self, 'detail_calculator') else None).pack(side=tk.LEFT, padx=5)
        tk.Button(proj_bar, text="📊 Excel", bg="#3498db", fg="white",
                  font=("Arial", 10, "bold"), cursor="hand2",
                  command=lambda: self.detail_calculator.export_current_xlsx() if hasattr(self, 'detail_calculator') else None).pack(side=tk.LEFT, padx=5)
        tk.Button(proj_bar, text="🖨️ Друк", bg="#9b59b6", fg="white",
                  font=("Arial", 10, "bold"), cursor="hand2",
                  command=lambda: self.detail_calculator.print_current() if hasattr(self, 'detail_calculator') else None).pack(side=tk.LEFT, padx=5)

        def on_proj_select(event=None):
            val = self.comp_project_combo.get()
            if val and hasattr(self, 'detail_calculator'):
                pid = int(val.split(":")[0])
                self.detail_calculator.set_project_id(pid)
                proj = next((p for p in projects if p[0] == pid), None)
                if proj and hasattr(self.detail_calculator, 'calc_client'):
                    self.detail_calculator.calc_client.delete(0, tk.END)
                    self.detail_calculator.calc_client.insert(0, proj[3] if proj[3] else "")

        self.comp_project_combo.bind("<<ComboboxSelected>>", on_proj_select)
        # =====================

        # === Canvas з прокруткою ===
        outer = tk.Frame(frame, bg=c["bg"])
        outer.pack(fill=tk.BOTH, expand=True)

        canvas = tk.Canvas(outer, bg=c["bg"], highlightthickness=0)
        vsb = ttk.Scrollbar(outer, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=vsb.set)

        vsb.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)

        calc_frame = tk.Frame(canvas, bg=c["bg"])
        canvas_window = canvas.create_window((0, 0), window=calc_frame, anchor="nw")

        def on_calc_configure(event):
            canvas.configure(scrollregion=canvas.bbox("all"))
            canvas.itemconfig(canvas_window, width=canvas.winfo_width())

        calc_frame.bind("<Configure>", on_calc_configure)
        canvas.bind("<Configure>", lambda e: canvas.itemconfig(canvas_window, width=e.width))
        # ==========================

        self.detail_calculator = DetailCalculatorFrame(calc_frame, colors=self.colors)
        self.detail_calculator.pack(fill=tk.BOTH, expand=True)
        on_proj_select()  # встановити project_id для першого проекту



        self.show_tab("components", "ВИРОБИ")

    # ==================== ВКЛАДКА: МАТЕРІАЛИ ====================
    def show_materials_tab(self):
        frame = self.tabs["materials"]
        for widget in frame.winfo_children():
            widget.destroy()

        c = self.colors
        tk.Label(frame, text="КАТАЛОГ МАТЕРІАЛІВ", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 18, "bold")).pack(pady=15)

        columns = ("Назва", "Ціна за м²", "Одиниця")
        tree = ttk.Treeview(frame, columns=columns, show="headings", height=20)
        for col in columns:
            tree.heading(col, text=col)
            tree.column(col, width=300)

        for name, data in MATERIALS.items():
            tree.insert("", tk.END, values=(name, data["ціна_за_м2"], data["одиниця"]))

        tree.pack(fill=tk.BOTH, expand=True, padx=20, pady=10)

        add_frame = tk.Frame(frame, bg=c["bg"])
        add_frame.pack(fill=tk.X, padx=20, pady=10)

        tk.Label(add_frame, text="Додати до проекту (ID):", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 12)).pack(side=tk.LEFT)
        pid_entry = tk.Entry(add_frame, font=("Arial", 12), width=10)
        pid_entry.pack(side=tk.LEFT, padx=5)

        tk.Label(add_frame, text="Матеріал:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 12)).pack(side=tk.LEFT, padx=10)
        mat_var = tk.StringVar(value=list(MATERIALS.keys())[0])
        ttk.Combobox(add_frame, textvariable=mat_var, values=list(MATERIALS.keys()),
                     font=("Arial", 12), width=25).pack(side=tk.LEFT)

        tk.Label(add_frame, text="Площа (м²):", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 12)).pack(side=tk.LEFT, padx=10)
        qty_entry = tk.Entry(add_frame, font=("Arial", 12), width=10)
        qty_entry.insert(0, "10")
        qty_entry.pack(side=tk.LEFT)

        def add_material_to_project():
            pid = int(pid_entry.get() or 0)
            if not pid:
                messagebox.showwarning("Увага", "Введіть ID проекту!")
                return
            project = Project.load_from_db(pid)
            if not project:
                messagebox.showerror("Помилка", "Проект не знайдено!")
                return
            mat_name = mat_var.get()
            qty = float(qty_entry.get() or 1)
            price = MATERIALS[mat_name]["ціна_за_м2"]
            unit = MATERIALS[mat_name]["одиниця"]
            project.add_material(mat_name, qty, unit, price)
            project.update_in_db()
            messagebox.showinfo("Успіх", f"Матеріал додано до проекту {project.project_number}")

        tk.Button(add_frame, text="ДОДАТИ", bg=c["accent"], fg="white",
                  font=("Arial", 11), command=add_material_to_project).pack(side=tk.LEFT, padx=20)

        self.show_tab("materials", "МАТЕРІАЛИ")

    # ==================== ВКЛАДКА: РОБОТИ ====================
    def _init_works_db(self):
        """Створює таблицю робіт у БД та заповнює її з WORKS якщо порожня."""
        try:
            execute_query("""
                CREATE TABLE IF NOT EXISTS works_catalog (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT UNIQUE NOT NULL,
                    price REAL NOT NULL,
                    unit TEXT NOT NULL,
                    description TEXT,
                    is_active INTEGER DEFAULT 1
                )
            """)
            count = execute_query("SELECT COUNT(*) FROM works_catalog WHERE is_active=1", fetch_one=True)[0]
            if count == 0:
                for name, data in WORKS.items():
                    price = data.get("ціна_за_м2", data.get("ціна_за_шт", data.get("ціна_за_систему", 0)))
                    unit = data.get("одиниця", "шт")
                    execute_query(
                        "INSERT OR IGNORE INTO works_catalog (name, price, unit, description) VALUES (?,?,?,?)",
                        (name, price, unit, "")
                    )
        except Exception as e:
            print(f"[works_db] init error: {e}")

    def load_works_data(self):
        for row in self.works_tree.get_children():
            self.works_tree.delete(row)
        try:
            rows = execute_query("SELECT * FROM works_catalog WHERE is_active=1 ORDER BY name")
            for r in rows:
                self.works_tree.insert("", tk.END, values=(r[0], r[1], f"{r[2]:.2f}", r[3], r[4] or ""))
            names = [r[1] for r in rows]
            self.work_combo_catalog["values"] = names
            if names:
                self.work_combo_catalog.current(0)
        except Exception as e:
            messagebox.showerror("Помилка", f"Не вдалося завантажити роботи: {e}")

    def on_work_project_selected(self, event=None):
        val = self.work_project_combo.get()
        if not val:
            return
        pid = int(val.split(":")[0])
        self.current_work_project_id = pid
        self.load_project_works(pid)

    def load_project_works(self, pid):
        for row in self.proj_works_tree.get_children():
            self.proj_works_tree.delete(row)
        try:
            rows = execute_query(
                "SELECT id, work_name, quantity, unit, unit_price, total_price FROM project_works WHERE project_id=? ORDER BY id",
                (pid,)
            )
            for r in rows:
                self.proj_works_tree.insert("", tk.END, values=(r[0], r[1], r[2], r[3], f"{r[4]:.2f}", f"{r[5]:.2f}"))
        except Exception as e:
            print(f"[load_project_works] error: {e}")

    def show_works_tab(self):
        frame = self.tabs["works"]
        for widget in frame.winfo_children():
            widget.destroy()

        c = self.colors
        self._init_works_db()

        # --- Canvas з прокруткою ---
        outer = tk.Frame(frame, bg=c["bg"])
        outer.pack(fill="both", expand=True)

        canvas = tk.Canvas(outer, bg=c["bg"], highlightthickness=0)
        vsb = ttk.Scrollbar(outer, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=vsb.set)
        vsb.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)

        scroll_frame = tk.Frame(canvas, bg=c["bg"])
        canvas_window = canvas.create_window((0, 0), window=scroll_frame, anchor="nw")

        def on_configure(event=None):
            canvas.configure(scrollregion=canvas.bbox("all"))
            canvas.itemconfig(canvas_window, width=canvas.winfo_width())

        scroll_frame.bind("<Configure>", on_configure)
        canvas.bind("<Configure>", lambda e: canvas.itemconfig(canvas_window, width=e.width))

        # --- Заголовок ---
        tk.Label(scroll_frame, text="КАТАЛОГ РОБІТ", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 18, "bold")).pack(pady=10)

        # --- Панель кнопок CRUD ---
        btn_frame = tk.Frame(scroll_frame, bg=c["bg"])
        btn_frame.pack(fill=tk.X, padx=20, pady=5)

        tk.Button(btn_frame, text="➕ Додати", bg="#27ae60", fg="white",
                  font=("Arial", 10), cursor="hand2",
                  command=self.add_work_dialog).pack(side=tk.LEFT, padx=5)
        tk.Button(btn_frame, text="✏️ Редагувати", bg="#f39c12", fg="white",
                  font=("Arial", 10), cursor="hand2",
                  command=self.edit_work_dialog).pack(side=tk.LEFT, padx=5)
        tk.Button(btn_frame, text="🗑 Видалити", bg="#e74c3c", fg="white",
                  font=("Arial", 10), cursor="hand2",
                  command=self.delete_work).pack(side=tk.LEFT, padx=5)
        tk.Button(btn_frame, text="🔄 Оновити", bg=c["accent"], fg="white",
                  font=("Arial", 10), cursor="hand2",
                  command=self.load_works_data).pack(side=tk.LEFT, padx=5)

        # --- Treeview каталогу ---
        columns = ("ID", "Назва", "Ціна", "Одиниця", "Опис")
        self.works_tree = ttk.Treeview(frame, columns=columns, show="headings", height=10)
        for col in columns:
            self.works_tree.heading(col, text=col)
        self.works_tree.column("ID", width=50, anchor="center")
        self.works_tree.column("Назва", width=250)
        self.works_tree.column("Ціна", width=100, anchor="center")
        self.works_tree.column("Одиниця", width=90, anchor="center")
        self.works_tree.column("Опис", width=300)

        vsb = ttk.Scrollbar(frame, orient=tk.VERTICAL, command=self.works_tree.yview)
        self.works_tree.configure(yscrollcommand=vsb.set)
        self.works_tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=(20, 0), pady=5)
        vsb.pack(side=tk.LEFT, fill=tk.Y, pady=5)

        self.load_works_data()

        # --- Роздільник ---
        sep = tk.Frame(scroll_frame, bg="#bbb", height=2)
        sep.pack(fill=tk.X, padx=20, pady=8)

        # --- Панель "Додати роботу до проекту" ---
        add_frame = tk.LabelFrame(scroll_frame, text="Додати роботу до проекту", bg=c["bg"],
                                   fg=c["fg"], font=("Arial", 11, "bold"))
        add_frame.pack(fill=tk.X, padx=20, pady=5)

        tk.Label(add_frame, text="Проект:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 10)).pack(side=tk.LEFT, padx=5)
        projects = Project.list_all_projects()
        self._work_project_list = projects
        proj_values = [f"{p[0]}: {p[2]}" for p in projects]
        self.work_project_combo = ttk.Combobox(add_frame, values=proj_values,
                                                font=("Arial", 10), width=35, state="readonly")
        self.work_project_combo.pack(side=tk.LEFT, padx=5)
        if proj_values:
            self.work_project_combo.current(0)
        self.work_project_combo.bind("<<ComboboxSelected>>", self.on_work_project_selected)

        tk.Label(add_frame, text="Робота:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 10)).pack(side=tk.LEFT, padx=(15, 5))
        self.work_var_catalog = tk.StringVar()
        self.work_combo_catalog = ttk.Combobox(add_frame, textvariable=self.work_var_catalog,
                                                 font=("Arial", 10), width=28, state="readonly")
        self.work_combo_catalog.pack(side=tk.LEFT)

        tk.Label(add_frame, text="Кількість:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 10)).pack(side=tk.LEFT, padx=(15, 5))
        self.work_qty_entry = tk.Entry(add_frame, font=("Arial", 10), width=8)
        self.work_qty_entry.insert(0, "1")
        self.work_qty_entry.pack(side=tk.LEFT)

        tk.Button(add_frame, text="➕ ДОДАТИ ДО ПРОЕКТУ", bg="#27ae60", fg="white",
                  font=("Arial", 10, "bold"), cursor="hand2",
                  command=self.add_work_to_project).pack(side=tk.LEFT, padx=20)

        # --- Таблиця робіт у проекті ---
        proj_frame = tk.LabelFrame(scroll_frame, text="Роботи у проекті", bg=c["bg"],
                                    fg=c["fg"], font=("Arial", 11, "bold"))
        proj_frame.pack(fill=tk.BOTH, expand=True, padx=20, pady=10)

        pw_btn = tk.Frame(proj_frame, bg=c["bg"])
        pw_btn.pack(fill=tk.X, pady=3)
        tk.Button(pw_btn, text="✏️ Змінити кількість", bg="#f39c12", fg="white",
                  font=("Arial", 9), cursor="hand2",
                  command=self.edit_project_work_qty).pack(side=tk.LEFT, padx=5)
        tk.Button(pw_btn, text="🗑 Видалити", bg="#e74c3c", fg="white",
                  font=("Arial", 9), cursor="hand2",
                  command=self.delete_project_work).pack(side=tk.LEFT, padx=5)
        tk.Button(pw_btn, text="🔄 Оновити", bg=c["accent"], fg="white",
                  font=("Arial", 9), cursor="hand2",
                  command=lambda: self.load_project_works(self.current_work_project_id)).pack(side=tk.LEFT, padx=5)

        pw_cols = ("ID", "Назва", "Кількість", "Одиниця", "Ціна за од.", "Сума")
        self.proj_works_tree = ttk.Treeview(proj_frame, columns=pw_cols, show="headings", height=6)
        for col in pw_cols:
            self.proj_works_tree.heading(col, text=col)
        self.proj_works_tree.column("ID", width=50, anchor="center")
        self.proj_works_tree.column("Назва", width=250)
        self.proj_works_tree.column("Кількість", width=80, anchor="center")
        self.proj_works_tree.column("Одиниця", width=80, anchor="center")
        self.proj_works_tree.column("Ціна за од.", width=100, anchor="center")
        self.proj_works_tree.column("Сума", width=100, anchor="center")

        pw_vsb = ttk.Scrollbar(proj_frame, orient=tk.VERTICAL, command=self.proj_works_tree.yview)
        self.proj_works_tree.configure(yscrollcommand=pw_vsb.set)
        self.proj_works_tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=(5, 0), pady=5)
        pw_vsb.pack(side=tk.LEFT, fill=tk.Y, pady=5)

        self.current_work_project_id = None
        if proj_values:
            self.current_work_project_id = int(proj_values[0].split(":")[0])
            self.load_project_works(self.current_work_project_id)

        self.show_tab("works", "РОБОТИ")

    def add_work_dialog(self):
        c = self.colors
        dialog = tk.Toplevel(self.root)
        dialog.title("Додати роботу")
        dialog.geometry("450x300")
        dialog.configure(bg=c["bg"])
        dialog.transient(self.root)
        dialog.grab_set()

        tk.Label(dialog, text="Назва роботи:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 11)).pack(anchor="w", padx=20, pady=(20, 5))
        name_entry = tk.Entry(dialog, font=("Arial", 11), width=40)
        name_entry.pack(fill="x", padx=20)

        row = tk.Frame(dialog, bg=c["bg"])
        row.pack(fill="x", padx=20, pady=10)

        tk.Label(row, text="Ціна:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 11)).pack(side=tk.LEFT)
        price_entry = tk.Entry(row, font=("Arial", 11), width=12)
        price_entry.insert(0, "0")
        price_entry.pack(side=tk.LEFT, padx=5)

        tk.Label(row, text="Одиниця:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 11)).pack(side=tk.LEFT, padx=(15, 5))
        unit_entry = tk.Entry(row, font=("Arial", 11), width=12)
        unit_entry.insert(0, "шт")
        unit_entry.pack(side=tk.LEFT, padx=5)

        tk.Label(dialog, text="Опис (необовязково):", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 11)).pack(anchor="w", padx=20, pady=(10, 5))
        desc_entry = tk.Entry(dialog, font=("Arial", 11), width=40)
        desc_entry.pack(fill="x", padx=20)

        def save():
            name = name_entry.get().strip()
            if not name:
                messagebox.showwarning("Увага", "Введіть назву роботи!")
                return
            try:
                price = float(price_entry.get().replace(",", "."))
            except ValueError:
                messagebox.showwarning("Увага", "Ціна має бути числом!")
                return
            unit = unit_entry.get().strip() or "шт"
            try:
                execute_query(
                    "INSERT INTO works_catalog (name, price, unit, description) VALUES (?,?,?,?)",
                    (name, price, unit, desc_entry.get().strip())
                )
                self.load_works_data()
                dialog.destroy()
                messagebox.showinfo("Успіх", f'Роботу "{name}" додано!')
            except Exception as e:
                messagebox.showerror("Помилка", str(e))

        tk.Button(dialog, text="Зберегти", bg="#27ae60", fg="white",
                  font=("Arial", 12, "bold"), command=save).pack(pady=20)

    def edit_work_dialog(self):
        selected = self.works_tree.selection()
        if not selected:
            messagebox.showwarning("Увага", "Оберіть роботу для редагування!")
            return
        work_id = self.works_tree.item(selected[0], "values")[0]

        row = execute_query("SELECT * FROM works_catalog WHERE id=?", (work_id,), fetch_one=True)
        if not row:
            messagebox.showerror("Помилка", "Роботу не знайдено!")
            return

        c = self.colors
        dialog = tk.Toplevel(self.root)
        dialog.title("Редагувати роботу")
        dialog.geometry("450x300")
        dialog.configure(bg=c["bg"])
        dialog.transient(self.root)
        dialog.grab_set()

        tk.Label(dialog, text="Назва роботи:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 11)).pack(anchor="w", padx=20, pady=(20, 5))
        name_entry = tk.Entry(dialog, font=("Arial", 11), width=40)
        name_entry.insert(0, row[1])
        name_entry.pack(fill="x", padx=20)

        rowf = tk.Frame(dialog, bg=c["bg"])
        rowf.pack(fill="x", padx=20, pady=10)

        tk.Label(rowf, text="Ціна:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 11)).pack(side=tk.LEFT)
        price_entry = tk.Entry(rowf, font=("Arial", 11), width=12)
        price_entry.insert(0, str(row[2]))
        price_entry.pack(side=tk.LEFT, padx=5)

        tk.Label(rowf, text="Одиниця:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 11)).pack(side=tk.LEFT, padx=(15, 5))
        unit_entry = tk.Entry(rowf, font=("Arial", 11), width=12)
        unit_entry.insert(0, row[3])
        unit_entry.pack(side=tk.LEFT, padx=5)

        tk.Label(dialog, text="Опис:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 11)).pack(anchor="w", padx=20, pady=(10, 5))
        desc_entry = tk.Entry(dialog, font=("Arial", 11), width=40)
        desc_entry.insert(0, row[4] or "")
        desc_entry.pack(fill="x", padx=20)

        def save():
            name = name_entry.get().strip()
            if not name:
                messagebox.showwarning("Увага", "Введіть назву роботи!")
                return
            try:
                price = float(price_entry.get().replace(",", "."))
            except ValueError:
                messagebox.showwarning("Увага", "Ціна має бути числом!")
                return
            unit = unit_entry.get().strip() or "шт"
            try:
                execute_query(
                    "UPDATE works_catalog SET name=?, price=?, unit=?, description=? WHERE id=?",
                    (name, price, unit, desc_entry.get().strip(), work_id)
                )
                self.load_works_data()
                dialog.destroy()
                messagebox.showinfo("Успіх", f'Роботу "{name}" оновлено!')
            except Exception as e:
                messagebox.showerror("Помилка", str(e))

        tk.Button(dialog, text="Зберегти зміни", bg="#f39c12", fg="white",
                  font=("Arial", 12, "bold"), command=save).pack(pady=20)

    def delete_work(self):
        selected = self.works_tree.selection()
        if not selected:
            messagebox.showwarning("Увага", "Оберіть роботу для видалення!")
            return
        work_id = self.works_tree.item(selected[0], "values")[0]
        work_name = self.works_tree.item(selected[0], "values")[1]
        if not messagebox.askyesno("Підтвердження", f'Видалити роботу "{work_name}"?'):
            return
        try:
            execute_query("UPDATE works_catalog SET is_active=0 WHERE id=?", (work_id,))
            self.load_works_data()
            messagebox.showinfo("Успіх", f'Роботу "{work_name}" видалено!')
        except Exception as e:
            messagebox.showerror("Помилка", str(e))

    def add_work_to_project(self):
        val = self.work_project_combo.get()
        if not val:
            messagebox.showwarning("Увага", "Оберіть проект!")
            return
        pid = int(val.split(":")[0])
        project = Project.load_from_db(pid)
        if not project:
            messagebox.showerror("Помилка", "Проект не знайдено!")
            return
        work_name = self.work_var_catalog.get()
        if not work_name:
            messagebox.showwarning("Увага", "Оберіть роботу!")
            return
        try:
            qty = float(self.work_qty_entry.get().replace(",", ".") or 1)
        except ValueError:
            messagebox.showwarning("Увага", "Кількість має бути числом!")
            return

        row = execute_query("SELECT price, unit FROM works_catalog WHERE name=? AND is_active=1",
                           (work_name,), fetch_one=True)
        if not row:
            messagebox.showerror("Помилка", "Роботу не знайдено в каталозі!")
            return
        price, unit = row[0], row[1]
        project.add_work(work_name, qty, unit, price)
        project.update_in_db()
        self.load_project_works(pid)
        messagebox.showinfo("Успіх", f'Роботу "{work_name}" додано до проекту {project.project_number}')

    def edit_project_work_qty(self):
        selected = self.proj_works_tree.selection()
        if not selected:
            messagebox.showwarning("Увага", "Оберіть роботу проекту для редагування!")
            return
        pw_id = self.proj_works_tree.item(selected[0], "values")[0]
        old_qty = self.proj_works_tree.item(selected[0], "values")[2]
        old_price = self.proj_works_tree.item(selected[0], "values")[4]

        c = self.colors
        dialog = tk.Toplevel(self.root)
        dialog.title("Змінити кількість")
        dialog.geometry("300x150")
        dialog.configure(bg=c["bg"])
        dialog.transient(self.root)
        dialog.grab_set()

        tk.Label(dialog, text="Нова кількість:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 11)).pack(pady=(15, 5))
        qty_entry = tk.Entry(dialog, font=("Arial", 11), width=12)
        qty_entry.insert(0, str(old_qty))
        qty_entry.pack()

        def save():
            try:
                new_qty = float(qty_entry.get().replace(",", "."))
            except ValueError:
                messagebox.showwarning("Увага", "Введіть число!")
                return
            new_total = new_qty * float(old_price)
            try:
                execute_query(
                    "UPDATE project_works SET quantity=?, total_price=? WHERE id=?",
                    (new_qty, new_total, pw_id)
                )
                self.load_project_works(self.current_work_project_id)
                dialog.destroy()
                messagebox.showinfo("Успіх", "Кількість оновлено!")
            except Exception as e:
                messagebox.showerror("Помилка", str(e))

        tk.Button(dialog, text="Зберегти", bg="#f39c12", fg="white",
                  font=("Arial", 11, "bold"), command=save).pack(pady=15)

    def delete_project_work(self):
        selected = self.proj_works_tree.selection()
        if not selected:
            messagebox.showwarning("Увага", "Оберіть роботу для видалення!")
            return
        pw_id = self.proj_works_tree.item(selected[0], "values")[0]
        pw_name = self.proj_works_tree.item(selected[0], "values")[1]
        if not messagebox.askyesno("Підтвердження", f'Видалити "{pw_name}" з проекту?'):
            return
        try:
            execute_query("DELETE FROM project_works WHERE id=?", (pw_id,))
            self.load_project_works(self.current_work_project_id)
            messagebox.showinfo("Успіх", f'Роботу "{pw_name}" видалено з проекту!')
        except Exception as e:
            messagebox.showerror("Помилка", str(e))

    # ==================== ВКЛАДКА: БУХГАЛТЕРІЯ ====================
    def show_accounting_tab(self):
        frame = self.tabs["accounting"]
        for widget in frame.winfo_children():
            widget.destroy()

        c = self.colors

        notebook = ttk.Notebook(frame)
        notebook.pack(fill="both", expand=True, padx=15, pady=10)

        # --- Підвкладка: Розрахунки ---
        calc_tab = tk.Frame(notebook, bg=c["bg"])
        notebook.add(calc_tab, text="  🧮 Розрахунки  ")
        self.show_calculations_tab(parent=calc_tab)

        # --- Підвкладка: Зарплата ---
        sal_tab = tk.Frame(notebook, bg=c["bg"])
        notebook.add(sal_tab, text="  💰 Зарплата  ")
        self.show_salary_tab(parent=sal_tab)

        # --- Підвкладка: Витрати ---
        exp_tab = tk.Frame(notebook, bg=c["bg"])
        notebook.add(exp_tab, text="  📉 Витрати  ")
        self.show_expenses_tab(parent=exp_tab)

        # --- Підвкладка: Звіти ---
        rep_tab = tk.Frame(notebook, bg=c["bg"])
        notebook.add(rep_tab, text="  📈 Звіти  ")
        self.show_reports_tab(parent=rep_tab)

        self.show_tab("accounting", "БУХГАЛТЕРІЯ")

    # ==================== ВКЛАДКА: РОЗРАХУНКИ ====================
    def show_calculations_tab(self, parent=None):
        frame = parent if parent else self.tabs["calculations"]
        for widget in frame.winfo_children():
            widget.destroy()

        c = self.colors

        if not parent:
            tk.Label(frame, text="РОЗРАХУНКИ ВАРТОСТІ", bg=c["bg"], fg=c["fg"],
                     font=("Arial", 18, "bold")).pack(pady=15)
        else:
            tk.Label(frame, text="РОЗРАХУНКИ ВАРТОСТІ", bg=c["bg"], fg=c["fg"],
                     font=("Arial", 14, "bold")).pack(pady=8)

        calc_frame = tk.Frame(frame, bg=c["bg"], padx=50)
        calc_frame.pack(fill=tk.BOTH, expand=True)

        tk.Label(calc_frame, text="ID проекту для розрахунку:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 14)).pack(anchor=tk.W, pady=10)

        pid_entry = tk.Entry(calc_frame, font=("Arial", 14), width=20)
        pid_entry.pack(anchor=tk.W)

        result_text = tk.Text(calc_frame, height=20, width=80, font=("Consolas", 12),
                              bg=c["card"], fg=c["fg"])
        result_text.pack(pady=20)

        def do_calculation():
            pid = int(pid_entry.get() or 0)
            if not pid:
                messagebox.showwarning("Увага", "Введіть ID проекту!")
                return
            project = Project.load_from_db(pid)
            if not project:
                messagebox.showerror("Помилка", "Проект не знайдено!")
                return

            calc = CostCalculator(project)
            result = calc.calculate()
            calc.save_calculation()

            result_text.delete(1.0, tk.END)
            result_text.insert(tk.END, f"""
РОЗРАХУНОК ВАРТОСТІ ПРОЕКТУ: {project.project_number}
{'='*50}
Матеріали:              {result['materials_cost']:>12.2f} грн
Комплектуючі:           {result['components_cost']:>12.2f} грн
Роботи:                 {result['works_cost']:>12.2f} грн
{'-'*50}
Прямі витрати:          {result['direct_costs']:>12.2f} грн
Накладні ({result['overhead_percentage']}%):       {result['overhead_cost']:>12.2f} грн
{'='*50}
СОБІВАРТІСТЬ:           {result['total_cost']:>12.2f} грн
Націнка ({result['markup_percentage']}%):         {result['markup_amount']:>12.2f} грн
Ціна без ПДВ:           {result['price_without_vat']:>12.2f} грн
ПДВ ({result['vat_rate']}%):             {result['vat_amount']:>12.2f} грн
{'='*50}
КІНЦЕВА ЦІНА (з ПДВ):   {result['final_price']:>12.2f} грн
{'='*50}
Прибуток:               {result['profit']:>12.2f} грн
Рентабельність:         {result['profit_margin_percent']:>12.2f} %
""")

        tk.Button(calc_frame, text="РОЗРАХУВАТИ", bg="#27ae60", fg="white",
                  font=("Arial", 14, "bold"), command=do_calculation).pack(pady=10)

        if not parent:
            self.show_tab("calculations", "РОЗРАХУНКИ")

    # ==================== ВКЛАДКА: ЗАРПЛАТА ====================
    def show_salary_tab(self, parent=None):
        frame = parent if parent else self.tabs["salary"]
        for widget in frame.winfo_children():
            widget.destroy()

        c = self.colors

        if not parent:
            tk.Label(frame, text="ЗАРПЛАТНИЙ ФОНД", bg=c["bg"], fg=c["fg"],
                     font=("Arial", 18, "bold")).pack(pady=15)
        else:
            tk.Label(frame, text="ЗАРПЛАТНИЙ ФОНД", bg=c["bg"], fg=c["fg"],
                     font=("Arial", 14, "bold")).pack(pady=8)

        calc_frame = tk.Frame(frame, bg=c["bg"], padx=50)
        calc_frame.pack(fill=tk.BOTH, expand=True)

        tk.Label(calc_frame, text="СПІВРОБІТНИКИ:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 14, "bold")).pack(anchor=tk.W, pady=10)

        self.salary_entries = []
        emp_frame = tk.Frame(calc_frame, bg=c["bg"])
        emp_frame.pack(fill=tk.X)

        for i, (pos_name, pos_data) in enumerate(POSITIONS.items()):
            row = tk.Frame(emp_frame, bg=c["bg"])
            row.pack(fill=tk.X, pady=3)

            tk.Label(row, text=f"{pos_name}:", bg=c["bg"], fg=c["fg"],
                     font=("Arial", 11), width=25, anchor=tk.E).pack(side=tk.LEFT)

            tk.Label(row, text=f"{pos_data['ставка']} грн", bg=c["bg"], fg=c["fg"],
                     font=("Arial", 11), width=15).pack(side=tk.LEFT)

            tk.Label(row, text=f"Премія {pos_data['премія_%']}%", bg=c["bg"], fg=c["fg"],
                     font=("Arial", 11), width=15).pack(side=tk.LEFT)

            entry = tk.Entry(row, font=("Arial", 11), width=25)
            entry.insert(0, f"Співробітник {i+1}")
            entry.pack(side=tk.LEFT, padx=10)
            self.salary_entries.append((pos_name, entry))

        result_text = tk.Text(calc_frame, height=15, width=80, font=("Consolas", 11),
                              bg=c["card"], fg=c["fg"])
        result_text.pack(pady=20)

        def calculate_salary():
            calc = SalaryCalculator()
            for pos_name, entry in self.salary_entries:
                name = entry.get()
                if name:
                    calc.add_employee(name, pos_name)

            result = calc.calculate_payroll()
            calc.save_to_db()

            result_text.delete(1.0, tk.END)
            result_text.insert(tk.END, f"""
ЗАРПЛАТНИЙ ФОНД
{'='*60}
Кількість співробітників: {result['employees_count']}
Загальний фонд (gross):  {result['total_gross']:>12.2f} грн
ПДФО (18%):              {result['total_pit']:>12.2f} грн
Військовий збір (1.5%):  {result['total_military_tax']:>12.2f} грн
ЄСВ (22%):               {result['total_esv']:>12.2f} грн
{'='*60}
ВСЬОГО ВИТРАТИ:          {result['total_employer_cost']:>12.2f} грн
Чиста зарплата:          {result['total_net']:>12.2f} грн
{'='*60}
""")

        tk.Button(calc_frame, text="РОЗРАХУВАТИ ЗАРПЛАТУ", bg="#27ae60", fg="white",
                  font=("Arial", 14, "bold"), command=calculate_salary).pack(pady=10)

        if not parent:
            self.show_tab("salary", "ЗАРПЛАТА")

    # ==================== ВКЛАДКА: ВИТРАТИ ====================
    def show_expenses_tab(self, parent=None):
        frame = parent if parent else self.tabs["expenses"]
        for widget in frame.winfo_children():
            widget.destroy()

        c = self.colors

        if not parent:
            tk.Label(frame, text="ОБЛІК ВИТРАТ", bg=c["bg"], fg=c["fg"],
                     font=("Arial", 18, "bold")).pack(pady=15)
        else:
            tk.Label(frame, text="ОБЛІК ВИТРАТ", bg=c["bg"], fg=c["fg"],
                     font=("Arial", 14, "bold")).pack(pady=8)

        exp_frame = tk.Frame(frame, bg=c["bg"], padx=50)
        exp_frame.pack(fill=tk.BOTH, expand=True)

        form = tk.Frame(exp_frame, bg=c["bg"])
        form.pack(fill=tk.X, pady=10)

        tk.Label(form, text="Категорія:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 12)).pack(side=tk.LEFT)
        cat_var = tk.StringVar(value="сировина_матеріали")
        ttk.Combobox(form, textvariable=cat_var, 
                     values=["сировина_матеріали", "комплектуючі", "зарплата_виробництво",
                             "електроенергія", "амортизація", "транспорт", "оренда", "інші"],
                     font=("Arial", 12), width=20).pack(side=tk.LEFT, padx=5)

        tk.Label(form, text="Сума:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 12)).pack(side=tk.LEFT, padx=10)
        amount_entry = tk.Entry(form, font=("Arial", 12), width=15)
        amount_entry.pack(side=tk.LEFT)

        tk.Label(form, text="Опис:", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 12)).pack(side=tk.LEFT, padx=10)
        desc_entry = tk.Entry(form, font=("Arial", 12), width=30)
        desc_entry.pack(side=tk.LEFT)

        self.expenses_list = []

        def add_expense():
            try:
                amount = float(amount_entry.get())
                self.expenses_list.append({
                    "category": cat_var.get(),
                    "amount": amount,
                    "description": desc_entry.get()
                })
                amount_entry.delete(0, tk.END)
                desc_entry.delete(0, tk.END)
                update_expenses_display()
            except ValueError:
                messagebox.showerror("Помилка", "Введіть коректну суму!")

        tk.Button(form, text="ДОДАТИ ВИТРАТУ", bg=c["accent"], fg="white",
                  font=("Arial", 11), command=add_expense).pack(side=tk.LEFT, padx=20)

        self.expenses_tree = ttk.Treeview(exp_frame, columns=("Категорія", "Сума", "Опис"),
                                          show="headings", height=15)
        for col in ("Категорія", "Сума", "Опис"):
            self.expenses_tree.heading(col, text=col)
            self.expenses_tree.column(col, width=250)
        self.expenses_tree.pack(fill=tk.BOTH, expand=True, pady=10)

        self.expenses_total_label = tk.Label(exp_frame, text="ВСЬОГО: 0.00 грн", 
                                             bg=c["bg"], fg=c["fg"],
                                             font=("Arial", 16, "bold"))
        self.expenses_total_label.pack(pady=10)

        def update_expenses_display():
            for item in self.expenses_tree.get_children():
                self.expenses_tree.delete(item)
            total = 0
            for exp in self.expenses_list:
                self.expenses_tree.insert("", tk.END, values=(exp["category"], exp["amount"], exp["description"]))
                total += exp["amount"]
            self.expenses_total_label.config(text=f"ВСЬОГО: {total:.2f} грн")

        if not parent:
            self.show_tab("expenses", "ВИТРАТИ")

    # ==================== ВКЛАДКА: АРХІВ ====================
    def show_archive_tab(self):
        frame = self.tabs["archive"]
        for widget in frame.winfo_children():
            widget.destroy()

        c = self.colors

        tk.Label(frame, text="АРХІВ ПРОЕКТІВ", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 18, "bold")).pack(pady=15)

        btn_frame = tk.Frame(frame, bg=c["bg"])
        btn_frame.pack(fill=tk.X, pady=10)

        tk.Button(btn_frame, text="Оновити", bg=c["accent"], fg="white",
                  font=("Arial", 11), command=self.show_archive_tab).pack(side=tk.LEFT, padx=5)
        tk.Button(btn_frame, text="Архівувати проект", bg="#9b59b6", fg="white",
                  font=("Arial", 11), command=self.archive_selected).pack(side=tk.LEFT, padx=5)

        columns = ("ID", "Назва архіву", "Проект", "Дата", "Розмір")
        self.archive_tree = ttk.Treeview(frame, columns=columns, show="headings", height=25)
        for col in columns:
            self.archive_tree.heading(col, text=col)
            self.archive_tree.column(col, width=180)
        self.archive_tree.column("ID", width=50)

        scrollbar = ttk.Scrollbar(frame, orient=tk.VERTICAL, command=self.archive_tree.yview)
        self.archive_tree.configure(yscrollcommand=scrollbar.set)

        self.archive_tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=20)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

        storage = ArchiveStorage()
        archives = storage.list_archives()
        for arch in archives:
            size_kb = arch[5] / 1024 if arch[5] else 0
            self.archive_tree.insert("", tk.END, values=(arch[0], arch[1], arch[2], arch[4][:10], f"{size_kb:.1f} КБ"))

        self.show_tab("archive", "АРХІВ")

    def archive_selected(self):
        pid = self.get_selected_project_id()
        if pid:
            project = Project.load_from_db(pid)
            if project:
                exporter = ProjectExporter(project)
                files = exporter.export_all()
                storage = ArchiveStorage()
                storage.archive_project(pid, project.project_number, files)
                messagebox.showinfo("Успіх", "Проект архівовано!")
                self.show_archive_tab()

    # ==================== ВКЛАДКА: АНАЛІТИКА ====================
    def show_analytics_tab(self):
        frame = self.tabs["analytics"]
        for widget in frame.winfo_children():
            widget.destroy()

        c = self.colors

        tk.Label(frame, text="АНАЛІТИЧНА ПАНЕЛЬ", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 18, "bold")).pack(pady=15)

        analytics_frame = tk.Frame(frame, bg=c["bg"], padx=50)
        analytics_frame.pack(fill=tk.BOTH, expand=True)

        analytics = ProductionAnalytics()
        projects = analytics.get_projects_stats()
        financial = analytics.get_financial_stats()

        def create_info_block(parent, title, data_lines):
            block = tk.Frame(parent, bg=c["card"], bd=2, relief=tk.RIDGE)
            block.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=10, pady=10)
            tk.Label(block, text=title, bg=c["card"], fg=c["fg"],
                     font=("Arial", 14, "bold")).pack(pady=10)
            for line in data_lines:
                tk.Label(block, text=line, bg=c["card"], fg=c["fg"],
                         font=("Arial", 12)).pack(anchor=tk.W, padx=15, pady=2)
            return block

        row1 = tk.Frame(analytics_frame, bg=c["bg"])
        row1.pack(fill=tk.X)

        create_info_block(row1, "ПРОЕКТИ", [
            f"Всього: {projects['total_projects']}",
            f"Клієнтів: {projects['total_clients']}",
            f"Чернетка: {projects['by_status'].get('draft', 0)}",
            f"Активні: {projects['by_status'].get('active', 0)}",
            f"Завершені: {projects['by_status'].get('completed', 0)}",
        ])

        create_info_block(row1, "ФІНАНСИ", [
            f"Виручка: {financial['total_revenue']:,.2f} грн",
            f"Собівартість: {financial['total_cost']:,.2f} грн",
            f"Прибуток: {financial['total_profit']:,.2f} грн",
            f"Рентабельність: {financial['avg_profit_margin']:.2f}%",
            f"Матеріали: {financial['total_materials']:,.2f} грн",
            f"Комплектуючі: {financial['total_components']:,.2f} грн",
        ])

        create_info_block(row1, "ТИПИ ВЕНТИЛЯЦІЇ", [
            f"{vtype}: {count}" for vtype, count in projects['by_type'].items()
        ])

        row2 = tk.Frame(analytics_frame, bg=c["bg"])
        row2.pack(fill=tk.X, pady=20)

        top_frame = tk.Frame(row2, bg=c["card"], bd=2, relief=tk.RIDGE)
        top_frame.pack(fill=tk.X, padx=10)
        tk.Label(top_frame, text="ТОП-5 ПРОЕКТІВ ЗА ПРИБУТКОМ", bg=c["card"], fg=c["fg"],
                 font=("Arial", 14, "bold")).pack(pady=10)

        top_projects = analytics.get_top_projects(5)
        for i, proj in enumerate(top_projects, 1):
            tk.Label(top_frame, text=f"{i}. {proj[0]} - {proj[1]} | Виручка: {proj[3]:.2f} грн | Прибуток: {proj[4]:.2f} грн",
                     bg=c["card"], fg=c["fg"], font=("Arial", 11)).pack(anchor=tk.W, padx=20, pady=2)

        self.show_tab("analytics", "АНАЛІТИКА")

    # ==================== ВКЛАДКА: ЗВІТИ ====================
    def show_reports_tab(self, parent=None):
        frame = parent if parent else self.tabs["reports"]
        for widget in frame.winfo_children():
            widget.destroy()

        c = self.colors

        if not parent:
            tk.Label(frame, text="ЗВІТИ", bg=c["bg"], fg=c["fg"],
                     font=("Arial", 18, "bold")).pack(pady=15)
        else:
            tk.Label(frame, text="ЗВІТИ", bg=c["bg"], fg=c["fg"],
                     font=("Arial", 14, "bold")).pack(pady=8)

        rep_frame = tk.Frame(frame, bg=c["bg"], padx=50, pady=30)
        rep_frame.pack(fill=tk.BOTH, expand=True)

        reporter = ReportGenerator()

        def gen_financial():
            path = reporter.generate_financial_report()
            messagebox.showinfo("Звіт", "Фінансовий звіт збережено:\n" + path)

        def gen_projects():
            path = reporter.generate_projects_report()
            messagebox.showinfo("Звіт", "Звіт по проєктах збережено:\n" + path)

        def gen_salary():
            path = reporter.generate_salary_report()
            messagebox.showinfo("Звіт", "Звіт по зарплаті збережено:\n" + path)

        def gen_full():
            path = reporter.generate_full_report()
            messagebox.showinfo("Звіт", "Зведений звіт збережено:\n" + path)

        buttons = [
            ("📊 Фінансовий звіт", gen_financial, "#3498db"),
            ("📋 Звіт по проєктах", gen_projects, "#2ecc71"),
            ("💰 Звіт по зарплаті", gen_salary, "#e74c3c"),
            ("📈 Зведений звіт", gen_full, "#9b59b6"),
        ]

        for text, cmd, color in buttons:
            tk.Button(rep_frame, text=text, bg=color, fg="white",
                      font=("Arial", 14, "bold"), width=35, pady=12,
                      command=cmd).pack(pady=10)

        if not parent:
            self.show_tab("reports", "ЗВІТИ")

    # ==================== ВКЛАДКА: РОЗКРІЙ ЛИСТА (CamDuct) ====================
    def show_camduct_tab(self):
        try:
            self.ensure_camduct_initialized()
            self.show_tab("camduct", "РОЗКРІЙ ЛИСТА")
        except Exception as e:
            messagebox.showerror("Помилка CamDuct", f"Не вдалося відкрити редактор розкрою: {type(e).__name__}: {e}")

    def generate_full_report(self):
        reporter = ReportGenerator()
        reporter.generate_full_report()
        messagebox.showinfo("Звіт", "Зведений звіт згенеровано!")

    def show_analytics(self):
        self.show_analytics_tab()

    # ==================== ВКЛАДКА: КРЕСЛЕННЯ (CAD) ====================
    def show_cad_tab(self):
        frame = self.tabs["cad"]
        for widget in frame.winfo_children():
            widget.destroy()

        c = self.colors
        tk.Label(frame, text="2D CAD — КРЕСЛЕННЯ ДЕТАЛЕЙ", bg=c["bg"], fg=c["fg"],
                 font=("Arial", 14, "bold")).pack(fill=tk.X, pady=(4, 2))

        cad_frame = tk.Frame(frame, bg=c["bg"])
        cad_frame.pack(fill=tk.BOTH, expand=True)

        self.cad_editor = CADEditorFrame(cad_frame, colors=self.colors)
        self.cad_editor.pack(fill=tk.BOTH, expand=True)

        self.show_tab("cad", "КРЕСЛЕННЯ")

    def show_about(self):
        messagebox.showinfo("Про програму", 
            "ВЕНТИЛЯЦІЙНА ВИРОБНИЧА ФІРМА\n"
            "Версія 1.0\n\n"
            "Модулі:\n"
            "1. Побудова проекту\n"
            "2. Розрахунки\n"
            "3. Архів та аналітика\n\n"
            "2026")


def main():
    root = tk.Tk()
    app = VentilationApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
